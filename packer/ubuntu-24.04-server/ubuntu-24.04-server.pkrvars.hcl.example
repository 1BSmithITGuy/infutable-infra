# Copy to ubuntu-24.04-server.pkrvars.hcl and fill in real values.
# The .pkrvars.hcl file is gitignored.

# --- Proxmox connection ----------------------------------------------------

proxmox_api_url          = "https://<FQDN>:8006/api2/json"
proxmox_api_token_id     = "<user@realm!tokenname>" 
    #  For local proxmox authentication (at the host level), the realm is pam
    #  For next deployment, either use ldap or pve (Proxmox account)

proxmox_api_token_secret = "<token-uuid>"

proxmox_tls_insecure     = true   
    #  Lab environment - in prod use tls

proxmox_node             = "<short-hostname>"   
    # Usually the short hostname of the Proxmox node

# --- ISO filenames ------------------------------------------------------------
# Lab:  In prod, should use Packer's built in tools iso_checksum with iso_url to verify checksum

ubuntu_iso_file   = "ubuntu-24.04-server.iso"


# --- Automation account / credentials ----------------------------
# The template's automation account (e.g. bs-auto). Used by Packer at build
# time and by Terraform/Ansible at runtime. Personal admin accounts (your own
# user, additional engineers) are layered in per-clone via cloud-init -- not
# baked into the template.
# Lab:  production should pull these from a secrets manager (Vault, sops, etc.)

automation_username      = "bs-auto"
ssh_authorized_pubkey    = "<pubkey>"
ssh_private_key_file     = "/srv/secrets/<path-to-key>"

jump_host_ip          = "<jump host IP>"
    #  Firewall - Allow SSH